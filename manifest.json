{
  "manifest_version": 3,
  "name": "Chrome Page",
  "version": "1.0.0",
  "minimum_chrome_version": "134",
  "description": "Fast bookmark workspace for the Chrome new tab.",
  "permissions": [
    "bookmarks",
    "favicon",
    "storage"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Chrome Page",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  }
}
